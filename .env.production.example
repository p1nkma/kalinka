# Public hostname and ACME contact
DOMAIN=ka-linka.ru
ACME_EMAIL=

# Set to the tag of the image built from the fork.
KALINKA_TAG=latest

POSTGRES_USER=kalinka
POSTGRES_DB=kalinka
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# AES-256 requires exactly 32 characters. Generate with: openssl rand -base64 24
CALENDSO_ENCRYPTION_KEY=

# Optional SMTP for booking and account notifications
EMAIL_FROM=
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
